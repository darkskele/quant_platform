BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100

AlignConsecutiveDeclarations: true
AlignConsecutiveAssignments: true
PointerAlignment: Left
ReferenceAlignment: Left

# One blank line forced between top-level definitions (functions, structs,
# classes, namespaces) — clang-format 14+. Blank lines *inside* a function
# are a manual call (write them, MaxEmptyLinesToKeep won't collapse them).
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1

NamespaceIndentation: None
SpaceBeforeParens: ControlStatements
