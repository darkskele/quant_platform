        {
            "name": "All benches",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/qp_bench",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "environment": [
