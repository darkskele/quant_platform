{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "All tests (debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/qp_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                },
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build: qp_tests (debug)"
        },
        {
