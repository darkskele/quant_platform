            "program": "${workspaceFolder}/benchmarks/python/run_all.py",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "${userHome}/miniconda3/envs/qp-research/bin/python",
            "preLaunchTask": "Build: qp_python_backtest module (release)"
        },
        {
