{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: qp_venue_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/libs/venue/qp_venue_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build: qp_venue_tests",
            "logging": { "engineLogging": false }
        },
        {
            "name": "Release: qp_venue_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/libs/venue/qp_venue_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build: qp_venue_tests (release)"
        },
        {
