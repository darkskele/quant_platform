        {
            "name": "Integration tests (tsan)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tsan/cmake/integration/qp_integration_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
