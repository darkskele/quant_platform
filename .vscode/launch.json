        {
            "name": "Python benches",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/benchmarks/python/run_all.py",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "${userHome}/miniconda3/envs/qp-research/bin/python",
            "preLaunchTask": "qp_python_backtest"
        },
        {
            "name": "Python tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/python/run_all.py",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "${userHome}/miniconda3/envs/qp-research/bin/python",
            "preLaunchTask": "qp_python_backtest"
        },
        {
            "name": "qp_binance_funding_carry",
            "type": "node-terminal",
            "request": "launch",
            "command": "find build/release -name 'qp_binance_funding_carry.*.so' -exec realpath {} \\;",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "qp_binance_funding_carry"
        },
        {
            "name": "qp_python_backtest",
            "type": "node-terminal",
            "request": "launch",
