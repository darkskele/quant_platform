{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure (debug)",
            "type": "shell",
            "command": "cmake --preset debug",
            "problemMatcher": [],
            "detail": "Ninja + ASan/UBSan. Cheap to re-run — CMake no-ops if nothing changed."
        },
        {
            "label": "Build: qp_venue_tests",
            "type": "shell",
            "command": "cmake --build build/debug --target qp_venue_tests -j",
            "dependsOn": "Configure (debug)",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "Just the parser unit tests and their deps — not the whole tree."
        },
        {
            "label": "Test: qp_venue_tests",
            "type": "shell",
            "command": "./build/debug/libs/venue/qp_venue_tests",
            "dependsOn": "Build: qp_venue_tests",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Configure (release)",
            "type": "shell",
            "command": "cmake --preset release",
            "problemMatcher": [],
            "detail": "No sanitizers, -O3 — benchmarks under the debug preset measure ASan/UBSan overhead, not the parser."
        },
        {
            "label": "Build: qp_venue_bench (release)",
            "type": "shell",
            "command": "cmake --build build/release --target qp_venue_bench -j",
            "dependsOn": "Configure (release)",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Just the parser benchmarks and their deps, release build."
        },
        {
            "label": "Run parser bench",
            "type": "shell",
            "command": "./build/release/libs/venue/qp_venue_bench",
            "dependsOn": "Build: qp_venue_bench (release)",
            "group": "test",
            "problemMatcher": [],
            "detail": "Release build — still WSL2, so trust deltas over absolutes (docs/environment.md)."
        },
        {
            "label": "Build: qp_venue_tests (release)",
            "type": "shell",
            "command": "cmake --build build/release --target qp_venue_tests -j",
            "dependsOn": "Configure (release)",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Same 12 tests at -O3/-DNDEBUG, no ASan/UBSan — catches optimization-exposed UB the debug build's instrumentation would otherwise mask, and is the correctness counterpart to the release bench numbers."
        },
        {
            "label": "Test: qp_venue_tests (release)",
            "type": "shell",
            "command": "./build/release/libs/venue/qp_venue_tests",
            "dependsOn": "Build: qp_venue_tests (release)",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Build: qp_core_tests",
            "type": "shell",
            "command": "cmake --build build/debug --target qp_core_tests -j",
            "dependsOn": "Configure (debug)",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "SPSC queue tests — functional correctness, ASan/UBSan."
        },
        {
            "label": "Test: qp_core_tests",
            "type": "shell",
            "command": "./build/debug/libs/core/qp_core_tests",
            "dependsOn": "Build: qp_core_tests",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Configure (tsan)",
            "type": "shell",
            "command": "cmake --preset tsan",
            "problemMatcher": [],
            "detail": "ThreadSanitizer — the actual point of testing a concurrent queue. Benchmarks excluded (QP_BUILD_BENCHMARKS=OFF baked into the preset)."
        },
        {
            "label": "Build: qp_core_tests (tsan)",
            "type": "shell",
            "command": "cmake --build build/tsan --target qp_core_tests -j",
            "dependsOn": "Configure (tsan)",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Test: qp_core_tests (tsan)",
            "type": "shell",
            "command": "setarch $(uname -m) -R ./build/tsan/libs/core/qp_core_tests",
            "dependsOn": "Build: qp_core_tests (tsan)",
            "group": "test",
            "problemMatcher": [],
            "detail": "setarch -R disables ASLR — TSan hits a known WSL2 memory-mapping issue without it."
        },
        {
            "label": "Build: qp_core_tests (release)",
            "type": "shell",
            "command": "cmake --build build/release --target qp_core_tests -j",
            "dependsOn": "Configure (release)",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Same SPSC queue tests at -O3/-DNDEBUG, no ASan/UBSan."
        },
        {
            "label": "Test: qp_core_tests (release)",
            "type": "shell",
            "command": "./build/release/libs/core/qp_core_tests",
            "dependsOn": "Build: qp_core_tests (release)",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Build: qp_core_bench (release)",
            "type": "shell",
            "command": "cmake --build build/release --target qp_core_bench -j",
            "dependsOn": "Configure (release)",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "SPSC queue push/pop benchmarks, release build."
        },
        {
            "label": "Run queue bench",
            "type": "shell",
            "command": "./build/release/libs/core/qp_core_bench",
            "dependsOn": "Build: qp_core_bench (release)",
            "group": "test",
            "problemMatcher": [],
            "detail": "Release build — still WSL2, so trust deltas over absolutes (docs/environment.md)."
        },
        {
            "label": "Build: everything",
            "type": "shell",
            "command": "cmake --build build/debug -j",
            "dependsOn": "Configure (debug)",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Full tree. Only reach for this when you actually need it — prefer a targeted build above."
        }
    ]
}
